# Groq API Key - Get yours at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Groq Model (optional, defaults to llama-3.3-70b-versatile)
GROQ_MODEL=your_model_here

# Server Port (optional, defaults to 3000)
PORT=3000

# GitHub Personal Access Token (optional, increases rate limit from 60 to 5000 requests/hour)
GITHUB_TOKEN=your_github_token_here
